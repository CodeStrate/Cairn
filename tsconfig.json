{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite for the renderer, esbuild for main and preload) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths (mirrored in vite.config.ts) */
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["./renderer/*"],
      "@main/*": ["./main/*"]
    }
  },
  "include": ["renderer", "main", "scripts", "vite.config.ts"]
}
